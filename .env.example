# Laravel API Connection (URL is non-sensitive, OK as NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL="https://app-api.edu-ai.eu/api"

# Server-side only — DO NOT prefix with NEXT_PUBLIC_, the key would leak
# into the client bundle and be visible to anyone loading the admin app.
ADMIN_API_KEY="your-admin-api-key"

# Sentry (project eduai-web). All optional: the DSN defaults to the eduai-web
# project (src/lib/sentry/options.ts), the environment is derived from
# NODE_ENV and NEXT_PUBLIC_API_URL (development / staging / production).
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""                       # server/edge override, else NEXT_PUBLIC_SENTRY_DSN
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Build time only, never commit: uploads source maps so stack traces are
# readable. Railway sets RAILWAY_GIT_COMMIT_SHA, which becomes the release.
# SENTRY_AUTH_TOKEN=""
# SENTRY_RELEASE=""                   # overrides RAILWAY_GIT_COMMIT_SHA
